# ─────────────────────────────────────────────────────────────────────────
#  dShield Global Site — local development
#
#  Copy this file, fill in your MySQL password, and you are running.
#  Nothing else here is required for the free scan or the free tools:
#  they use no third-party service and no API key.
# ─────────────────────────────────────────────────────────────────────────

# Where the React app finds the API in production. Ignored in development,
# where it always talks to localhost:4008.
REACT_APP_API=https://dshield.dolluzcorp.com

# Absolute base for canonical URLs and the sitemap. Set this per
# environment — a staging deploy that emits production canonicals
# tells Google the real page lives elsewhere and de-indexes itself.
REACT_APP_SITE_URL=https://dshield.dolluzcorp.com

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=dshield

# ── Server ──────────────────────────────────────────────────────────────
# Do NOT add a PORT line here.
#
# react-scripts reads this file into process.env before starting, and takes
# PORT for the React dev server. A PORT meant for Express ends up moving the
# FRONTEND onto the API's port instead. The API port is hardcoded in
# server.js (4008); the React dev server uses 3000, or the next free port.

# ── Not needed yet ──────────────────────────────────────────────────────
# Payments and email are not wired on this app. Razorpay onboarding and the
# legal documents are outstanding, so the pricing page collects interest
# rather than taking money. Leave these until that changes.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Email ───────────────────────────────────────────────────────────────
# Mail goes through the mail_outbox table, never straight to SendGrid, so a
# provider outage cannot lose a message. Leave SENDGRID_API_KEY blank in
# development: rows still queue and will send the moment a key is added.
# ENQUIRY_ALERT_TO is where enquiry alerts land — a real Dolluz address.
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@dolluzcorp.com
SENDGRID_FROM_NAME=dShield
ENQUIRY_ALERT_TO=
MAIL_WORKER_ENABLED=true
