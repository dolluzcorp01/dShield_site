{
    // F5 always starts the API, whatever file happens to be open in the
    // editor. Without this VS Code launches the active file under Node, so
    // pressing F5 with a React page focused dies on its first import.
    //
    // The React dev server is not here on purpose: it runs in a terminal
    // with `npm start`, where its output and hot reload belong.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "API — server.js",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
